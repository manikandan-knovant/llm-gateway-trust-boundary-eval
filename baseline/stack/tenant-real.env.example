# Synthetic tenant for the real-provider sample (local research values only). Presidio + regex, cost guard ON.
# GW_OPENAI_API_KEY is NOT here: harness/keyenv.py puts it into the environment of one command only.
COMPOSE_PROFILES=presidio,real
TENANT_SLUG=<tenant-id-real>
POLICY_FILE=policy-real.yaml
ROUTES_FILE=routes-real.yaml
MASTER_KEY=<set-locally>
PG_PASSWORD=<set-locally>
CONSOLE_PG_PASSWORD=<set-locally>
COST_GUARD=on
IDP_TENANT=<idp-tenant-guid>
CONSOLE_AUDIENCE=<console-audience>
OWNER_GROUP=<owner-group-guid>
GW_PORT=4301
CONSOLE_PORT=4311
ISSUER_PORT=4321
MOCK_PORT=4331
